@model RestablecerPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
    ViewData["ActiveNav"] = "administracion";
}

<div class="page-head">
    <div>
        <a class="back-link" asp-action="Index">
            <span class="icon icon-arrow-left icon-xs"></span>Volver a administración
        </a>
        <p class="eyebrow">Accesos y seguridad · RF-09</p>
        <h1 class="page-title">Restablecer contraseña</h1>
        <p class="page-sub">Asigna una nueva contraseña temporal y compártela por un canal seguro.</p>
    </div>
</div>

<form class="panel form-panel admin-password-form" method="post" asp-action="ResetPassword">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="notice notice-danger" role="alert"></div>

    <div class="admin-user-summary">
        <span class="avatar admin-avatar">@(Model.NombreCompleto.Length > 0 ? Model.NombreCompleto[..1].ToUpper() : "?")</span>
        <div>
            <strong>@Model.NombreCompleto</strong>
            <span>@Model.Email</span>
        </div>
    </div>

    <div class="form-grid">
        <div class="form-field">
            <label asp-for="Password" class="field-label">Nueva contraseña</label>
            <input asp-for="Password" class="input" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="ConfirmPassword" class="field-label">Confirmar contraseña</label>
            <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
    </div>

    <p class="field-hint">La contraseña debe tener al menos 6 caracteres e incluir un número.</p>

    <div class="form-actions">
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
        <button class="btn btn-primary" type="submit">
            <span class="icon icon-lock"></span>Restablecer contraseña
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
