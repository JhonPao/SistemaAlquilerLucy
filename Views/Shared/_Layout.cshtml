@using System.Globalization
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var usuario = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var nombreCompleto = usuario?.NombreCompleto ?? User.Identity?.Name ?? string.Empty;
    var partes = nombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var primerNombre = partes.Length > 0 ? partes[0] : nombreCompleto;
    var iniciales = partes.Length > 1
        ? $"{partes[0][0]}{partes[1][0]}".ToUpper()
        : (partes.Length == 1 ? partes[0][..1].ToUpper() : "?");
    var rol = User.IsInRole("Administradora") ? "Administradora"
        : User.IsInRole("Vendedor") ? "Vendedor"
        : User.IsInRole("Asistente") ? "Asistente"
        : "Usuario";
    var activo = ViewData["ActiveNav"] as string ?? string.Empty;
    var meses = new[] { "ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "set", "oct", "nov", "dic" };
    var hoy = $"{DateTime.Now.Day:00} {meses[DateTime.Now.Month - 1]} {DateTime.Now.Year}";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · LucyVest Control</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar-principal" aria-label="Navegación principal">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">lv</span>
                <span>
                    <span class="brand-name">LucyVest</span>
                    <span class="brand-sub">CONTROL</span>
                </span>
            </a>

            <div class="sede">
                <strong>Taller principal</strong>
                <span>Lima, Perú · S/</span>
            </div>

            <nav class="nav">
                <span class="nav-group">Gestión del taller</span>
                <a class="nav-item @(activo == "panel" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <span class="icon icon-dashboard"></span>Panel general
                </a>
                <a class="nav-item @(activo == "prendas" ? "active" : "")" asp-controller="Prendas" asp-action="Index">
                    <span class="icon icon-shirt"></span>Inventario
                </a>
                <a class="nav-item @(activo == "clientes" ? "active" : "")" asp-controller="Clientes" asp-action="Index">
                    <span class="icon icon-users"></span>Clientes
                </a>
                <a class="nav-item @(activo == "alquileres" ? "active" : "")" asp-controller="Alquileres" asp-action="Index">
                    <span class="icon icon-file-text"></span>Alquileres
                </a>
                <a class="nav-item @(activo == "devoluciones" ? "active" : "")" asp-controller="Devoluciones" asp-action="Index">
                    <span class="icon icon-package-check"></span>Devoluciones
                </a>
                <a class="nav-item @(activo == "mantenimiento" ? "active" : "")" asp-controller="Mantenimientos" asp-action="Index">
                    <span class="icon icon-washing"></span>Mantenimiento
                </a>
                @if (User.IsInRole("Administradora") || User.IsInRole("Vendedor"))
                {
                    <a class="nav-item @(activo == "reportes" ? "active" : "")" asp-controller="Reportes" asp-action="Index">
                        <span class="icon icon-chart"></span>Reportes y auditoría
                    </a>
                }
                @if (User.IsInRole("Administradora"))
                {
                    <a class="nav-item @(activo == "administracion" ? "active" : "")" asp-controller="Administracion" asp-action="Index">
                        <span class="icon icon-settings"></span>Administración
                    </a>
                }
            </nav>

            <div class="sidebar-note">
                <span class="icon icon-sparkles"></span>
                <p class="sidebar-note-title">Cada prenda, una historia.</p>
                <p class="sidebar-note-body">Cuidamos los detalles de cada alquiler.</p>
            </div>

            <div class="sidebar-account">
                <div class="account">
                    <span class="avatar">@iniciales</span>
                    <span>
                        <strong>@nombreCompleto</strong>
                        <small>@rol</small>
                    </span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="logout">
                        <span class="icon icon-logout"></span>Cerrar sesión
                    </button>
                </form>
            </div>
        </aside>

        <div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

        <div class="workspace">
            <header class="topbar">
                <div class="topbar-left">
                    <button type="button"
                            class="mobile-menu-btn"
                            id="mobile-menu-toggle"
                            aria-label="Abrir menú"
                            aria-expanded="false"
                            aria-controls="sidebar-principal">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <nav class="breadcrumb" aria-label="Ruta de navegación">
                        <span>Operaciones</span>
                        <span class="sep">/</span>
                        <strong>@ViewData["Title"]</strong>
                    </nav>
                </div>
                <div class="topbar-right">
                    <span class="demo-badge">Datos de demostración</span>
                    <span class="today">@hoy</span>
                    <button type="button" class="icon-btn" aria-label="Notificaciones">
                        <span class="icon icon-bell"></span>
                    </button>
                </div>
            </header>

            <main class="page">
                @RenderBody()
                <footer class="page-foot">
                    <span>LucyVest Control · Gestión de vestuario</span>
                    <span>Entorno de demostración · Perú</span>
                </footer>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
